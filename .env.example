# Browser and reader on the same host: keep the loopback binding.
READER_BIND_ADDRESS=127.0.0.1
# Set these to the owner of .reader-data (id -u / id -g).
READER_UID=1000
READER_GID=1000

# Required for translation: an OpenAI-compatible Chat Completions endpoint.
# The reader uses LLM models only; no offline fallback is started.
TRANSLATION_LLM_BASE_URL=
TRANSLATION_LLM_MODEL=
# Optional additional models at the same endpoint, separated by commas.
TRANSLATION_LLM_MODELS=
TRANSLATION_LLM_API_KEY=
# Optional fixed terminology, for example: "retrieval-augmented generation=检索增强生成; benchmark=基准测试"
TRANSLATION_GLOSSARY=
# Optional outbound proxy for the academic-model API. Leave empty when the
# reader container has direct external access.
TRANSLATION_LLM_PROXY=
